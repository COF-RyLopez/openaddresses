{
    "coverage": {
        "US Census": {
            "geoid": "06073",
            "name": "San Diego County",
            "state": "California"
        },
        "country": "us",
        "state": "ca",
        "county": "San Diego"
    },
    "schema": 2,
    "layers": {
        "addresses": [
            {
                "name": "county",
                "attribution": "San Diego Geographic Information Source - JPA",
                "data": "https://geo.sandag.org/server/rest/directories/downloads/Address_Points_shapefile.zip",
                "license": {
                    "url": "https://gis.sangis.org/sanportal/apps/storymaps/stories/d26146d84e834ff6bcd58e4e620a983a",
                    "text": "Indemnification"
                },
                "note": "Metadata available at https://geo.sandag.org/server/rest/directories/downloads/Address_Points.pdf",
                "website": "https://geo.sandag.org/portal/home/item.html?id=b1c2fd749f6847ccae6040cf0f803647",
                "compression": "zip",
                "protocol": "http",
                "conform": {
                    "format": "shapefile",
                    "number": [
                        "ADDRNMBR",
                        "ADDRFRAC"
                    ],
                    "street": {
                        "function": "chain",
                        "variable": "street_wip",
                        "functions": [
                            {
                                "function": "join",
                                "fields": [
                                    "ADDRPDIR",
                                    "ADDRNAME",
                                    "ADDRSFX",
                                    "ADDRPOSTD"
                                ],
                                "separator": " "
                            },
                            {
                                "function": "regexp",
                                "field": "oa:street_wip",
                                "pattern": "(?i)\\b0+([1-9][0-9]*(?:ST|ND|RD|TH))\\b|^",
                                "replace": "$1"
                            }
                        ]
                    },
                    "unit": "ADDRUNIT",
                    "city": "COMMUNITY",
                    "region": "STATE",
                    "postcode": "ADDRZIP",
                    "id": "ADDRAPNID"
                },
                "test": {
                    "enabled": true,
                    "description": "single-digit ordinal street names are zero-padded in the source (05TH); the padding is dropped so they match the road network",
                    "acceptance-tests": [
                        {
                            "description": "a zero-padded ordinal loses its padding",
                            "inputs": {
                                "ADDRNMBR": "1470",
                                "ADDRFRAC": "",
                                "ADDRPDIR": "",
                                "ADDRNAME": "05TH",
                                "ADDRSFX": "ST",
                                "ADDRPOSTD": "",
                                "ADDRUNIT": "",
                                "COMMUNITY": "IMPERIAL BEACH",
                                "STATE": "CA",
                                "ADDRZIP": "91932",
                                "ADDRAPNID": "1"
                            },
                            "expected": {
                                "street": "5TH ST"
                            }
                        },
                        {
                            "description": "a pre-directional is kept",
                            "inputs": {
                                "ADDRNMBR": "100",
                                "ADDRFRAC": "",
                                "ADDRPDIR": "W",
                                "ADDRNAME": "02ND",
                                "ADDRSFX": "AVE",
                                "ADDRPOSTD": "",
                                "ADDRUNIT": "",
                                "COMMUNITY": "ESCONDIDO",
                                "STATE": "CA",
                                "ADDRZIP": "92025",
                                "ADDRAPNID": "2"
                            },
                            "expected": {
                                "street": "W 2ND AVE"
                            }
                        },
                        {
                            "description": "multi-digit ordinals and named streets are unchanged",
                            "inputs": {
                                "ADDRNMBR": "307",
                                "ADDRFRAC": "",
                                "ADDRPDIR": "",
                                "ADDRNAME": "IMPERIAL BEACH",
                                "ADDRSFX": "BLVD",
                                "ADDRPOSTD": "",
                                "ADDRUNIT": "",
                                "COMMUNITY": "IMPERIAL BEACH",
                                "STATE": "CA",
                                "ADDRZIP": "91932",
                                "ADDRAPNID": "3"
                            },
                            "expected": {
                                "street": "IMPERIAL BEACH BLVD"
                            }
                        }
                    ]
                }
            }
        ],
        "parcels": [
            {
                "name": "county",
                "attribution": "San Diego Geographic Information Source - JPA",
                "data": "https://geo.sandag.org/server/rest/services/Hosted/Parcels/FeatureServer/0",
                "license": {
                    "url": "https://gis.sangis.org/sanportal/apps/storymaps/stories/d26146d84e834ff6bcd58e4e620a983a",
                    "text": "Indemnification"
                },
                "note": "Metadata available at https://geo.sandag.org/server/rest/directories/downloads/Parcels.pdf",
                "website": "https://geo.sandag.org/portal/home/item.html?id=032a5dcf654c4ccbb18711ad8a0ee754",
                "protocol": "ESRI",
                "conform": {
                    "format": "geojson",
                    "pid": "apn"
                }
            }
        ],
        "buildings": [
            {
                "name": "county",
                "attribution": "San Diego Geographic Information Source - JPA",
                "data": "https://geo.sandag.org/server/rest/services/Hosted/Building_Outlines/FeatureServer/0",
                "license": {
                    "url": "https://gis.sangis.org/sanportal/apps/storymaps/stories/d26146d84e834ff6bcd58e4e620a983a",
                    "text": "Indemnification"
                },
                "note": "Metadata available at https://geo.sandag.org/server/rest/directories/downloads/Building_Outlines.pdf",
                "website": "https://geo.sandag.org/portal/home/item.html?id=dbb0e0b9894c4d6b96d44999e3c05165",
                "protocol": "ESRI",
                "conform": {
                    "format": "geojson"
                }
            }
        ],
        "centerlines": [
            {
                "name": "county",
                "data": "https://gis-public.sandiegocounty.gov/arcgis/rest/services/sdep_warehouse/ROAD_SEGMENTS/FeatureServer/0",
                "protocol": "ESRI",
                "conform": {
                    "format": "geojson",
                    "id": "ROAD_SEG_ID",
                    "name": "ROAD_NAME",
                    "classification": {
                        "function": "map",
                        "field": "CALTRANS_FUNCTION_CLASS",
                        "mapping": {
                            "1": "motorway",
                            "2": "trunk",
                            "3": "primary",
                            "4": "secondary",
                            "5": "tertiary",
                            "6": "tertiary",
                            "7": "residential"
                        },
                        "else": "residential"
                    }
                }
            }
        ]
    }
}
